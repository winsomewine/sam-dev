function aepf_metrics()
{
	metric( 'ppa', {'label'='\u7b2c\u4e00\u5e74PPA\u7535\u4ef7', 'post'= ' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // PPA price in Year 1
	metric( 'ppa_escalation', {'label'='PPA\u7535\u4ef7\u589e\u957f\u7387', 'mode'='f', 'post'=' %/\u5e74', 'deci'='2' } ); // PPA price escalation
	metric( 'lppa_nom', {'label'='LPPA \u5e73\u51c6\u5316PPA\u7535\u4ef7\uff08\u540d\u4e49\uff09', 'mode'='f', 'post'=' \u00A2/kWh', 'deci'='2' } ); // LPPA Levelized PPA price nominal
	metric( 'lppa_real', {'label'='LPPA \u5e73\u51c6\u5316PPA\u7535\u4ef7\uff08\u5b9e\u9645\uff09', 'mode'='f', 'post'=' \u00A2/kWh', 'deci'='2' } ); // LPPA Levelized PPA price real
	metric( 'lcoe_nom', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u540d\u4e49\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // LCOE Levelized cost of energy nominal
	metric( 'lcoe_real', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u5b9e\u9645\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // LCOE Levelized cost of energy real
	metric( 'flip_actual_irr', {'label'='\u7ffb\u8f6c\u5e74\u6295\u8d44\u8005IRR', 'mode'='f', 'post'=' %', 'deci'='2' } ); // Investor IRR in flip year
	metric( 'flip_actual_year', {'label'='\u7ffb\u8f6c\u5e74', 'post'=' '} ); // Flip year
	metric( 'tax_investor_aftertax_irr', {'label'='\u9879\u76ee\u7ed3\u675f\u65f6\u6295\u8d44\u8005IRR', 'mode'='f', 'post'=' %', 'deci'='2' } ); // Investor IRR at end of project
	metric( 'tax_investor_aftertax_npv', {'label'='\u9879\u76ee\u5168\u5468\u671f\u6295\u8d44\u8005NPV', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Investor NPV over project life
	metric( 'sponsor_aftertax_irr', {'label'='\u9879\u76ee\u7ed3\u675f\u65f6\u5f00\u53d1\u5546IRR', 'mode'='f', 'post'=' %', 'deci'='2' } ); // Developer IRR at end of project
	metric( 'sponsor_aftertax_npv', {'label'='\u9879\u76ee\u5168\u5468\u671f\u5f00\u53d1\u5546NPV', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Developer NPV over project life
    metric( 'adjusted_installed_cost', {'label'='\u51c0\u8d44\u672c\u6210\u672c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Net capital cost
}

function lpf_metrics()
{
	metric( 'ppa', {'label'='\u7b2c\u4e00\u5e74PPA\u7535\u4ef7', 'post'= ' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // PPA price in Year 1
	metric( 'ppa_escalation', {'label'='PPA\u7535\u4ef7\u589e\u957f\u7387', 'mode'='f', 'post'=' %/\u5e74', 'deci'='2' } ); // PPA price escalation
	metric( 'lppa_nom', {'label'='LPPA \u5e73\u51c6\u5316PPA\u7535\u4ef7\uff08\u540d\u4e49\uff09', 'mode'='f', 'post'=' \u00A2/kWh', 'deci'='2' } ); // LPPA Levelized PPA price nominal
	metric( 'lppa_real', {'label'='LPPA \u5e73\u51c6\u5316PPA\u7535\u4ef7\uff08\u5b9e\u9645\uff09', 'mode'='f', 'post'=' \u00A2/kWh', 'deci'='2' } ); // LPPA Levelized PPA price real
	metric( 'lcoe_nom', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u540d\u4e49\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // LCOE Levelized cost of energy nominal
	metric( 'lcoe_real', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u5b9e\u9645\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // LCOE Levelized cost of energy real
	metric( 'flip_actual_irr', {'label'='\u6295\u8d44\u8005IRR \u5185\u90e8\u6536\u76ca\u7387', 'mode'='f', 'post'=' %', 'deci'='2' } ); // Investor IRR Internal rate of return
	metric( 'flip_actual_year', {'label'='\u7ffb\u8f6c\u5e74', 'post'=' '} ); // Flip year
	metric( 'tax_investor_aftertax_irr', {'label'='\u9879\u76ee\u7ed3\u675f\u65f6\u6295\u8d44\u8005IRR', 'mode'='f', 'post'=' %', 'deci'='2' } ); // Investor IRR at end of project
	metric( 'tax_investor_aftertax_npv', {'label'='\u9879\u76ee\u5168\u5468\u671f\u6295\u8d44\u8005NPV', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Investor NPV over project life
	metric( 'sponsor_aftertax_irr', {'label'='\u9879\u76ee\u7ed3\u675f\u65f6\u5f00\u53d1\u5546IRR', 'mode'='f', 'post'=' %', 'deci'='2' } ); // Developer IRR at end of project
	metric( 'sponsor_aftertax_npv', {'label'='\u9879\u76ee\u5168\u5468\u671f\u5f00\u53d1\u5546NPV', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Developer NPV over project life
	metric( 'cost_installed', {'label'='\u51c0\u8d44\u672c\u6210\u672c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Net capital cost
	metric( 'size_of_equity', {'label'='\u6743\u76ca', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Equity
	metric( 'size_of_debt', {'label'='\u503a\u52a1', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Debt
	if ( value('debt_option')==0 )
	{
		metric( 'min_dscr', {'label'='\u6700\u5c0fDSCR','mode'='f', 'deci'='2' } ); // Minimum DSCR
	}
	else
	{
		metric( 'debt_fraction', {'label'='\u503a\u52a1\u5360\u6bd4','mode'='f', 'deci'='2', 'post'='%' } ); // Debt percent
	}
}

function cs_metrics()
{
	metric_table('table_cs_owner', {'headers'='\u4e1a\u4e3b\u6307\u6807,'}); // Owner Metrics
	metric_row( 'lcoe_nom', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u540d\u4e49\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2','tableName'='table_cs_owner' } ); // LCOE levelized cost of energy nominal
	metric_row( 'lcoe_real', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u5b9e\u9645\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2','tableName'='table_cs_owner' } ); // LCOE Levelized cost of energy real
	metric_row( 'project_return_aftertax_npv', {'label'='NPV \u51c0\u73b0\u503c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ','tableName'='table_cs_owner' } ); // NPV Net present value
	metric_row( 'project_return_aftertax_irr', {'label'='IRR \u5185\u90e8\u6536\u76ca\u7387', 'mode'='f', 'post'=' %', 'deci'='2','tableName'='table_cs_owner' } ); // IRR Internal rate of return
	metric_row( 'cost_installed', {'label'='\u51c0\u8d44\u672c\u6210\u672c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ','tableName'='table_cs_owner' } ); // Net capital cost
	metric_row( 'size_of_equity', {'label'='\u6743\u76ca', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ','tableName'='table_cs_owner' } ); // Equity
	metric_row( 'size_of_debt', {'label'='\u503a\u52a1\u89c4\u6a21', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ','tableName'='table_cs_owner' } ); // Size of debt
	if ( value('debt_option')==0 )
	{
		metric_row( 'min_dscr', {'label'='\u6700\u5c0fDSCR','mode'='f', 'deci'='2', 'tableName'='table_cs_owner' } ); // Minimum DSCR
	}
	else
	{
		metric_row( 'debt_fraction', {'label'='\u503a\u52a1\u5360\u6bd4','mode'='f', 'deci'='2', 'post'='%', 'tableName'='table_cs_owner' } ); // Debt percent
	}

	metric_table('table_cs_subscriber', {'headers'='\u8ba2\u9605\u8005\u6307\u6807\uff08\u6309\u7c7b\u522b\uff09,'}); // Subscriber Metrics by Class
	if ( value('subscriber1_name') != '' ) { metric_row( 'subscriber1_name', {'label'='\u8ba2\u9605\u8005 1 \u540d\u79f0','tableName'='table_cs_subscriber' }); } // Subscriber 1 Name
	if ( value('subscriber2_name') != '' && sum(value('subscriber2_share')) > 0 ) { metric_row( 'subscriber2_name', {'label'='\u8ba2\u9605\u8005 2 \u540d\u79f0','tableName'='table_cs_subscriber' }); } // Subscriber 2 Name
	if ( value('subscriber3_name') != '' && sum(value('subscriber3_share')) > 0 ) { metric_row( 'subscriber3_name', {'label'='\u8ba2\u9605\u8005 3 \u540d\u79f0','tableName'='table_cs_subscriber' }); } // Subscriber 3 Name
	if ( value('subscriber4_name') != '' && sum(value('subscriber4_share')) > 0 ) { metric_row( 'subscriber4_name', {'label'='\u8ba2\u9605\u8005 4 \u540d\u79f0','tableName'='table_cs_subscriber' }); } // Subscriber 4 Name
	metric_row( 'subscriber1_npv', {'label'='\u8ba2\u9605\u8005 1 NPV \u51c0\u73b0\u503c', 'mode'='f', 'deci'='2', 'thousep'='true', 'post'= ' ', 'pre'='$','tableName'='table_cs_subscriber' }); // Subscriber 1 NPV Net present value
	if ( sum(value('subscriber2_share')) > 0  ) { metric_row( 'subscriber2_npv', {'label'='\u8ba2\u9605\u8005 2 NPV \u51c0\u73b0\u503c', 'mode'='f', 'deci'='2', 'thousep'='true', 'post'= ' ', 'pre'='$','tableName'='table_cs_subscriber' }); } // Subscriber 2 NPV Net present value
	if ( sum(value('subscriber3_share')) > 0  ) { metric_row( 'subscriber3_npv', {'label'='\u8ba2\u9605\u8005 3 NPV \u51c0\u73b0\u503c', 'mode'='f', 'deci'='2', 'thousep'='true', 'post'= ' ', 'pre'='$','tableName'='table_cs_subscriber' }); } // Subscriber 3 NPV Net present value
	if ( sum(value('subscriber4_share')) > 0  ) { metric_row( 'subscriber4_npv', {'label'='\u8ba2\u9605\u8005 4 NPV \u51c0\u73b0\u503c', 'mode'='f', 'deci'='2', 'thousep'='true', 'post'= ' ', 'pre'='$','tableName'='table_cs_subscriber' }); } // Subscriber 4 NPV Net present value
}

