function pv_battery_metrics()
{
	metric( 'annual_energy', {'label'='\u5e74\u4ea4\u6d41\u53d1\u7535\u91cf\uff08\u7b2c\u4e00\u5e74\uff09', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWh' } ); // Annual AC energy in Year 1
	metric( 'capacity_factor', {'label'='\u76f4\u6d41\u5bb9\u91cf\u56e0\u5b50\uff08\u7b2c\u4e00\u5e74\uff09', 'mode'='f', 'deci'='1', 'thousep'='true', 'post'='%' } ); // DC capacity factor in Year 1
	metric( 'kwh_per_kw', {'label'='\u7b2c\u4e00\u5e74\u80fd\u6e90\u4ea7\u91cf', 'mode'='f', 'deci'='0', 'thousep'='true' } ); // Energy yield in Year 1
	metric( 'performance_ratio', {'label'='\u7b2c\u4e00\u5e74\u6027\u80fd\u6bd4', 'mode'='f', 'deci'='2', 'post'='' } ); // Performance ratio in Year 1
	metric( 'average_battery_roundtrip_efficiency', {'label'='\u7535\u6c60\u5f80\u8fd4\u6548\u7387', 'mode'='f', 'deci'='2', 'post'='%' } );//includes inverter and ancillary // Battery roundtrip efficiency
	metric( 'batt_system_charge_percent', {'label'='\u7535\u6c60\u4ece\u7cfb\u7edf\u5145\u7535\u7684\u80fd\u91cf', 'mode'='f', 'deci'='1', 'thousep'='false', 'post'='%' } ); // Battery charge energy from system
	if ( is_btm() )
	{
		if ( value('run_resiliency_calcs') == 1 )
		{
			metric('resilience_hrs_avg', {'label'='\u7535\u6c60\u5e73\u5747\u81ea\u4e3b\u8fd0\u884c\u5c0f\u65f6\u6570', 'mode'='f', 'deci'='2', 'post'=' hours' }); // Battery average hours of autonomy
		}
	}
	//metric( 'lcos_nom', {'label'='LCOS Levelized cost of storage nominal', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2' } );
	//metric( 'lcos_real', {'label'='LCOS Levelized cost of storage real', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2' } );
}

function wind_power_metrics()
{
	metric( 'annual_energy', {'label'='\u5e74\u4ea4\u6d41\u53d1\u7535\u91cf\uff08\u7b2c\u4e00\u5e74\uff09', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWh' } ); // Annual AC energy in Year 1
	metric('system_capacity', {'label'='\u5bb9\u91cf','mode'='f','deci'='0','thousep'='true','post'=' kW'} );// where is wind farm capacity metric? // Capacity
	metric( 'capacity_factor', {'label'='\u7b2c\u4e00\u5e74\u5bb9\u91cf\u56e0\u5b50', 'mode'='f', 'deci'='1', 'thousep'='true', 'post'='%' } ); // Capacity factor in Year 1
	// where is the approximate land use metric?
	if ( value( 'en_wind_uncertainty' ) )
	{
		metric( 'annual_energy_p90', {'label'='\u7b2c\u4e00\u5e74P90\u4ea4\u6d41\u53d1\u7535\u91cf', 'mode'='f', 'deci'='1', 'thousep'='true', 'post'=' kWh' } ); // P90 AC Energy in Year 1
	}
}

function physical_trough_metrics()
{
	//metric( 'annual_gross_energy', {'label'='Annual Gross Electrical Energy Production', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWh' } );
	metric( 'annual_energy', {'label'='\u7b2c\u4e00\u5e74\u4ea4\u6d41\u53d1\u7535\u91cf', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWhe' } ); // Annual AC energy in year 1
	metric( 'annual_thermal_consumption', {'label'='\u5e74\u9632\u51bb\u4fdd\u62a4', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWhe' } ); // Annual freeze protection
	metric( 'annual_tes_freeze_protection', {'label'='\u5e74\u50a8\u70ed\u7cfb\u7edf\u9632\u51bb\u4fdd\u62a4', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWhe' } ); // Annual TES freeze protection
	metric( 'annual_field_freeze_protection', {'label'='\u5e74\u573a\u57df\u9632\u51bb\u4fdd\u62a4', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWhe' } ); // Annual field freeze protection
	metric( 'capacity_factor', {'label'='\u5bb9\u91cf\u56e0\u5b50', 'mode'='f', 'deci'='1', 'thousep'='true', 'post'='%' } ); // Capacity factor
	metric( 'annual_W_cycle_gross', {'label'='\u52a8\u529b\u5faa\u73af\u603b\u7535\u529b\u8f93\u51fa', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWhe' } ); // Power cycle gross electrical output
	metric( 'kwh_per_kw', {'label'='\u7b2c\u4e00\u5e74 kWh/kW', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' -' } ); // First year kWh/kW
	metric( 'conversion_factor', {'label'='\u603b-\u51c0\u8f6c\u6362', 'mode'='f', 'deci'='1', 'thousep'='true', 'post'=' %' } ); // Gross-to-net conversion
	metric( 'annual_total_water_use', {'label'='\u5e74\u7528\u6c34\u91cf','mode'='f','deci'='0','thousep'='true','post'=' m^3' } ); // Annual water usage
}

function physical_trough_iph_metrics()
{
