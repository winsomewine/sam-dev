function is_btm()
{
	return ( financing() == 'Residential' ||
		     financing() == 'Commercial' ||
		     financing() == 'Third Party' ||
		     financing() == 'Host Developer' );
}



function rescom_metrics()
{
	metric( 'lcoe_nom',{'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u540d\u4e49\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // LCOE Levelized cost of energy nominal
	metric( 'lcoe_real',{'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u5b9e\u9645\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // LCOE Levelized cost of energy real
	metric( 'utility_bill_wo_sys_year1',{'label'='\u65e0\u7cfb\u7edf\u65f6\u7684\u7535\u8d39\uff08\u7b2c\u4e00\u5e74\uff09', 'pre'='$', 'post'=' ', 'thousep'='true', 'mode'='f', 'deci'='0' } ); // Electricity bill without system (year 1)
	metric( 'utility_bill_w_sys_year1',{'label'='\u6709\u7cfb\u7edf\u65f6\u7684\u7535\u8d39\uff08\u7b2c\u4e00\u5e74\uff09', 'pre'='$', 'post'=' ', 'thousep'='true', 'mode'='f', 'deci'='0' } ); // Electricity bill with system (year 1)
	metric( 'savings_year1',{'label'='\u7cfb\u7edf\u7684\u51c0\u8282\u7701\uff08\u7b2c\u4e00\u5e74\uff09', 'pre'='$', 'post'=' ', 'thousep'='true', 'mode'='f', 'deci'='0' } ); // Net savings with system (year 1)
	metric( 'npv', {'label'='\u51c0\u73b0\u503c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Net present value
	metric( 'payback', {'label'='\u7b80\u5355\u56de\u6536\u671f', 'mode'='f', 'deci'='1', 'thousep'='true', 'post'=' \u5e74' } ); // Simple payback period
	metric( 'discounted_payback', {'label'='\u6298\u73b0\u56de\u6536\u671f', 'mode'='f', 'deci'='1', 'thousep'='true', 'post'=' \u5e74' } ); // Discounted payback period
	metric( 'adjusted_installed_cost', {'label'='\u51c0\u8d44\u672c\u6210\u672c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Net capital cost
	metric( 'first_cost', {'label'='\u6743\u76ca', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Equity
	metric( 'loan_amount', {'label'='\u503a\u52a1', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Debt
}

function rescom_metrics_heat()
{
	metric( 'lcoe_nom',{'label'='LCOH \u5e73\u51c6\u5316\u70ed\u80fd\u6210\u672c\uff08\u540d\u4e49\uff09', 'post'=' \u00A2/kWht', 'mode'='f', 'deci'='2' } );
	metric( 'lcoe_real',{'label'='LCOH \u5e73\u51c6\u5316\u70ed\u80fd\u6210\u672c\uff08\u5b9e\u9645\uff09', 'post'=' \u00A2/kWht', 'mode'='f', 'deci'='2' } );
	metric( 'thermal_cost_without_system_year1',{'label'='\u70ed\u80fd\u8d26\u5355\u65e0\u7cfb\u7edf\uff08\u7b2c\u4e00\u5e74\uff09', 'pre'='$', 'post'=' ', 'thousep'='true', 'mode'='f', 'deci'='0' } );
	metric( 'thermal_cost_with_system_year1',{'label'='\u70ed\u80fd\u8d26\u5355\u6709\u7cfb\u7edf\uff08\u7b2c\u4e00\u5e74\uff09', 'pre'='$', 'post'=' ', 'thousep'='true', 'mode'='f', 'deci'='0' } );
	metric( 'thermal_savings_year1',{'label'='\u51c0\u8282\u7701\u6709\u7cfb\u7edf\uff08\u7b2c\u4e00\u5e74\uff09', 'pre'='$', 'post'=' ', 'thousep'='true', 'mode'='f', 'deci'='0' } );
	metric( 'npv', {'label'='\u51c0\u73b0\u503c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } );
	metric( 'payback', {'label'='\u7b80\u5355\u56de\u6536\u671f', 'mode'='f', 'deci'='1', 'thousep'='true', 'post'=' \u5e74' } );
	metric( 'discounted_payback', {'label'='\u6298\u73b0\u56de\u6536\u671f', 'mode'='f', 'deci'='1', 'thousep'='true', 'post'=' \u5e74' } );
	metric( 'adjusted_installed_cost', {'label'='\u51c0\u8d44\u672c\u6210\u672c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } );
	metric( 'first_cost', {'label'='\u6743\u76ca', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } );
	metric( 'loan_amount', {'label'='\u503a\u52a1', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } );
}

function third_party_metrics()
{
	metric( 'npv', {'label'='\u51c0\u73b0\u503c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } );
}

function host_developer_metrics()
{
	tech = technology();
	metric_table('TPOProjectMetrics', {'headers'='\u9879\u76ee\u6307\u6807, '});
	if ( tech == 'CustomGeneration PVWatts Wind FuelCell Battery Hybrid' || tech == 'Photovoltaic Wind Battery Hybrid' || tech == 'PVWatts Wind FuelCell Battery Hybrid' || tech == 'PVWatts Wind Battery Hybrid' )
	{
		  metric_row( 'annual_energy', {'label'='\u7b2c\u4e00\u5e74\u603b\u53d1\u7535\u91cf', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWh', 'tableName'='TPOProjectMetrics' } );
	}
	metric_row( 'lcoe_nom', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u540d\u4e49\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2', 'thousep'='false', 'tableName'='TPOProjectMetrics' } );
	metric_row( 'lcoe_real', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u5b9e\u9645\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2', 'thousep'='false', 'tableName'='TPOProjectMetrics' } );
	metric_row( 'ppa', {'label'='\u7b2c\u4e00\u5e74PPA\u7535\u4ef7', 'post'= ' \u00A2/kWh', 'mode'='f', 'deci'='2', 'thousep'='false', 'tableName'='TPOProjectMetrics' } );
	metric_row( 'lppa_nom', {'label'='LPPA \u5e73\u51c6\u5316PPA\u7535\u4ef7\uff08\u540d\u4e49\uff09', 'mode'='f', 'post'=' \u00A2/kWh', 'deci'='2', 'thousep'='false', 'tableName'='TPOProjectMetrics' } );
	metric_row( 'lppa_real', {'label'='LPPA \u5e73\u51c6\u5316PPA\u7535\u4ef7\uff08\u5b9e\u9645\uff09', 'mode'='f', 'post'=' \u00A2/kWh', 'deci'='2', 'thousep'='false', 'tableName'='TPOProjectMetrics' } );
	metric_row( 'cost_installed', {'label'='\u51c0\u8d44\u672c\u6210\u672c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ', 'tableName'='TPOProjectMetrics' } );
	metric_row( 'size_of_equity', {'label'='\u6743\u76ca', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ', 'tableName'='TPOProjectMetrics' } );
	metric_row( 'size_of_debt', {'label'='\u503a\u52a1\u89c4\u6a21', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ', 'tableName'='TPOProjectMetrics' } );
	if ( value('debt_option')==0 )
	{
		metric_row( 'min_dscr', {'label'='\u6700\u5c0fDSCR','mode'='f', 'deci'='2', 'tableName'='TPOProjectMetrics' } );
	}
	else
	{
		metric_row( 'debt_fraction', {'label'='\u503a\u52a1\u5360\u6bd4','mode'='f', 'deci'='2', 'post'='%', 'tableName'='TPOProjectMetrics' } );
	}
	
	metric_table('TPODeveloperMetrics', {'headers'='\u5f00\u53d1\u5546\u6307\u6807, '});
	metric_row( 'flip_actual_irr', {'label'='IRR \u5f00\u53d1\u5546\u5185\u90e8\u6536\u76ca\u7387', 'mode'='f', 'post'='%', 'deci'='2', 'thousep'='false', 'tableName'='TPODeveloperMetrics' } );
	metric_row( 'flip_actual_year', {'label'='\u5b9e\u73b0\u5f00\u53d1\u5546IRR\u7684\u5e74\u4efd', 'post'=' ', 'thousep'='false', 'tableName'='TPODeveloperMetrics' } );
	metric_row( 'project_return_aftertax_npv', {'label'='NPV \u5f00\u53d1\u5546\u51c0\u73b0\u503c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ', 'tableName'='TPODeveloperMetrics' } );

	metric_table('TPOHostMetrics', {'headers'='\u4e1a\u4e3b\u6307\u6807, '});
	metric_row( 'npv', {'label'='\u4e1a\u4e3b\u51c0\u73b0\u503c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ', 'tableName'='TPOHostMetrics' } );
	metric_row( 'year1_nte', {'label'='\u7b2c\u4e00\u5e74\u4e1a\u4e3b\u65e0\u5dee\u522b\u70b9', 'mode'='f', 'deci'='2', 'thousep'='false', 'post'='\u00A2/kWh', 'tableName'='TPOHostMetrics' } );
	metric_row( 'lnte_nom', {'label'='\u4e1a\u4e3b\u65e0\u5dee\u522b\u70b9\u5e73\u51c6\u5316\uff08\u540d\u4e49\uff09', 'mode'='f', 'deci'='2', 'thousep'='false', 'post'='\u00A2/kWh', 'tableName'='TPOHostMetrics' } );
	metric_row( 'lnte_real', {'label'='\u4e1a\u4e3b\u65e0\u5dee\u522b\u70b9\u5e73\u51c6\u5316\uff08\u5b9e\u9645\uff09', 'mode'='f', 'deci'='2', 'thousep'='false', 'post'='\u00A2/kWh', 'tableName'='TPOHostMetrics' } );
}

function lcoefcr_metrics()
{
	metric( 'lcoe_fcr', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c', 'mode'='f', 'deci'='2', 'post'=' \u00A2/kWh' , 'scale'='100'} ); //
}

function iph_lcoefcr_metrics()
{
	metric( 'lcoe_fcr', {'label'='LCOH \u5e73\u51c6\u5316\u70ed\u80fd\u6210\u672c', 'mode'='f', 'deci'='2', 'post'=' \u00A2/kWht' , 'scale'='100'} );
}

function so_metrics()
{
	metric( 'ppa', {'label'='\u7b2c\u4e00\u5e74PPA\u7535\u4ef7', 'post'= ' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // PPA price in Year 1
	metric( 'ppa_escalation', {'label'='PPA\u7535\u4ef7\u589e\u957f\u7387', 'mode'='f', 'post'=' %/\u5e74', 'deci'='2' } ); // PPA price escalation
	metric( 'lppa_nom', {'label'='LPPA \u5e73\u51c6\u5316PPA\u7535\u4ef7\uff08\u540d\u4e49\uff09', 'mode'='f', 'post'=' \u00A2/kWh', 'deci'='2' } ); // LPPA Levelized PPA price nominal
	metric( 'lppa_real', {'label'='LPPA \u5e73\u51c6\u5316PPA\u7535\u4ef7\uff08\u5b9e\u9645\uff09', 'mode'='f', 'post'=' \u00A2/kWh', 'deci'='2' } ); // LPPA Levelized PPA price real
	metric( 'lcoe_nom', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u540d\u4e49\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // LCOE Levelized cost of energy nominal
	metric( 'lcoe_real', {'label'='LCOE \u5e73\u51c6\u5316\u80fd\u6e90\u6210\u672c\uff08\u5b9e\u9645\uff09', 'post'=' \u00A2/kWh', 'mode'='f', 'deci'='2' } ); // LCOE Levelized cost of energy real
	metric( 'project_return_aftertax_npv', {'label'='NPV \u51c0\u73b0\u503c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // NPV Net present value
	metric( 'flip_actual_irr', {'label'='IRR \u5185\u90e8\u6536\u76ca\u7387', 'mode'='f', 'post'=' %', 'deci'='2' } ); // IRR Internal rate of return
	metric( 'flip_actual_year', {'label'='\u5b9e\u73b0IRR\u7684\u5e74\u4efd', 'post'=' '} ); // Year IRR is achieved
	metric( 'project_return_aftertax_irr', {'label'='\u9879\u76ee\u7ed3\u675fIRR', 'mode'='f', 'post'=' %', 'deci'='2' } ); // IRR at end of project
	metric( 'cost_installed', {'label'='\u51c0\u8d44\u672c\u6210\u672c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Net capital cost
	metric( 'size_of_equity', {'label'='\u6743\u76ca', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Equity
	metric( 'size_of_debt', {'label'='\u503a\u52a1\u89c4\u6a21', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Size of debt
	if ( value('debt_option')==0 )
	{
		metric( 'min_dscr', {'label'='\u6700\u5c0fDSCR','mode'='f', 'deci'='2' } ); // Minimum DSCR
	}
	else
	{
		metric( 'debt_fraction', {'label'='\u503a\u52a1\u5360\u6bd4','mode'='f', 'deci'='2', 'post'='%' } ); // Debt percent
	}
}

function so_metrics_heat()
{
	metric( 'ppa', {'label'='\u7b2c\u4e00\u5e74PPA\u70ed\u4ef7', 'post'= ' \u00A2/kWht', 'mode'='f', 'deci'='2' } ); // PPA price in Year 1
	metric( 'ppa_escalation', {'label'='PPA\u70ed\u4ef7\u589e\u957f\u7387', 'mode'='f', 'post'=' %/\u5e74', 'deci'='2' } ); // PPA price escalation
	metric( 'lppa_nom', {'label'='LPPA \u5e73\u51c6\u5316PPA\u70ed\u4ef7\uff08\u540d\u4e49\uff09', 'mode'='f', 'post'=' \u00A2/kWht', 'deci'='2' } ); // LPPA Levelized PPA price nominal
	metric( 'lppa_real', {'label'='LPPA \u5e73\u51c6\u5316PPA\u70ed\u4ef7\uff08\u5b9e\u9645\uff09', 'mode'='f', 'post'=' \u00A2/kWht', 'deci'='2' } ); // LPPA Levelized PPA price real
	metric( 'lcoe_nom', {'label'='LCOH \u5e73\u51c6\u5316\u70ed\u80fd\u6210\u672c\uff08\u540d\u4e49\uff09', 'post'=' \u00A2/kWht', 'mode'='f', 'deci'='2' } ); // LCOH Levelized cost of heat nominal
	metric( 'lcoe_real', {'label'='LCOH \u5e73\u51c6\u5316\u70ed\u80fd\u6210\u672c\uff08\u5b9e\u9645\uff09', 'post'=' \u00A2/kWht', 'mode'='f', 'deci'='2' } ); // LCOH Levelized cost of heat real
	metric( 'project_return_aftertax_npv', {'label'='NPV \u51c0\u73b0\u503c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // NPV Net present value
	metric( 'flip_actual_irr', {'label'='IRR \u5185\u90e8\u6536\u76ca\u7387', 'mode'='f', 'post'=' %', 'deci'='2' } ); // IRR Internal rate of return
	metric( 'flip_actual_year', {'label'='\u5b9e\u73b0IRR\u7684\u5e74\u4efd', 'post'=' '} ); // Year IRR is achieved
	metric( 'project_return_aftertax_irr', {'label'='\u9879\u76ee\u7ed3\u675f\u65f6IRR', 'mode'='f', 'post'=' %', 'deci'='2' } ); // IRR at end of project
	metric( 'cost_installed', {'label'='\u51c0\u8d44\u672c\u6210\u672c', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Net capital cost
	metric( 'size_of_equity', {'label'='\u6743\u76ca', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Equity
	metric( 'size_of_debt', {'label'='\u503a\u52a1\u89c4\u6a21', 'mode'='f', 'deci'='0', 'thousep'='true', 'pre'='$', 'post'=' ' } ); // Size of debt
	if ( value('debt_option')==0 )
	{
		metric( 'min_dscr', {'label'='\u6700\u5c0fDSCR','mode'='f', 'deci'='2' } ); // Minimum DSCR
	}
	else
	{
		metric( 'debt_fraction', {'label'='\u503a\u52a1\u5360\u6bd4','mode'='f', 'deci'='2', 'post'='%' } ); // Debt percent
	}
}


