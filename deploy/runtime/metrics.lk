function resiliency_metrics()
{
	if (!${crit_load_is_shown})
		return;
	metric( 'resilience_hrs_avg', {'label'='\u97e7\u6027\u5e73\u5747\u81ea\u6301\u5c0f\u65f6\u6570', 'mode'='f', 'deci'='2', 'thousep'='true', 'post'=' hrs' } );
}

// Technology Metrics
metrics{ 'Flat Plate PV' } = define() {
	pv_metrics();
	if ( is_assigned('resilience_hrs_avg'))
		resiliency_metrics();
};

metrics{ 'PVWatts' } = define() {
	pvwatts_metrics();

	if ( is_assigned('resilience_hrs_avg'))
		resiliency_metrics();
};

metrics{ 'Fuel Cell' } = define() {
	pvwatts_metrics();
	if ( value('en_batt') == 1 )
	{ metric( 'average_battery_roundtrip_efficiency', {'label'='\u7535\u6c60\u5f80\u8fd4\u6548\u7387', 'mode'='f', 'deci'='2', 'post'='%' } ); }
	metric( 'thermal_cost_without_system_year1',{'label'='\u70ed\u80fd\u8d26\u5355\u65e0\u7cfb\u7edf\uff08\u7b2c\u4e00\u5e74\uff09', 'pre'='$', 'post'=' ', 'thousep'='true', 'mode'='f', 'deci'='0' } ); // Thermal bill without system (year 1)
	metric( 'thermal_cost_with_system_year1',{'label'='\u70ed\u80fd\u8d26\u5355\u6709\u7cfb\u7edf\uff08\u7b2c\u4e00\u5e74\uff09', 'pre'='$', 'post'=' ', 'thousep'='true', 'mode'='f', 'deci'='0' } ); // Thermal bill with system (year 1)
	metric( 'thermal_savings_year1',{'label'='\u70ed\u80fd\u51c0\u8282\u7701\u6709\u7cfb\u7edf\uff08\u7b2c\u4e00\u5e74\uff09', 'pre'='$', 'post'=' ', 'thousep'='true', 'mode'='f', 'deci'='0' } ); // Net thermal savings with system (year 1)

};

function MEwave_metrics()
{

	//metric_row( 'annual_energy', {'label'='Annual energy production', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWh', 'tableName'='Table1' } );

	//metric_table('Table1', {'headers'='Metric,Value'});
	//me_lcoefcr_metrics();
	if(value('system_capacity') > 1) {
		metric( 'annual_energy', {'label'='\u5e74\u4ea7\u80fd', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWh', 'tableName'='Table1' } ); // Annual energy production
		metric( 'device_average_power', {'label'='\u6bcf\u8bbe\u5907\u5e73\u5747\u529f\u7387', 'mode'='f', 'deci'='0', 'thousep'='true','post'=' kW', 'tableName'='Table1' } ); // Average power per device
		metric( 'system_capacity', {'label'='\u7cfb\u7edf\u5bb9\u91cf', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'= ' kW', 'tableName'='Table1'}); // System capacity
		metric( 'capacity_factor', {'label'='\u5bb9\u91cf\u56e0\u5b50', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'= ' %', 'tableName'='Table1'}); // Capacity factor
	}
	else {
		metric( 'annual_energy', {'label'='\u5e74\u4ea7\u80fd', 'mode'='f', 'deci'='3', 'thousep'='true', 'post'=' kWh', 'tableName'='Table1', 'scale'='1' } ); // Annual energy production
		metric( 'device_average_power', {'label'='\u6bcf\u8bbe\u5907\u5e73\u5747\u529f\u7387', 'mode'='f', 'deci'='3', 'thousep'='true','post'=' kW', 'tableName'='Table1','scale'='1' } ); // Average power per device
		metric( 'system_capacity', {'label'='\u7cfb\u7edf\u5bb9\u91cf', 'mode'='f', 'deci'='3', 'thousep'='true', 'post'= ' kW', 'tableName'='Table1','scale'='1'}); // System capacity
		metric( 'capacity_factor', {'label'='\u5bb9\u91cf\u56e0\u5b50', 'mode'='f', 'deci'='3', 'thousep'='true', 'post'= ' %', 'tableName'='Table1','scale'='1'}); // Capacity factor
	}

	if (financing()  != "None") {
		metric_table('Table2', {'headers'='\u7c7b\u522b,\u6210\u672c,\u5355\u4f4d\u5bb9\u91cf\u6210\u672c,LCOE'}); // Category,Cost,Cost per capacity,LCOE
		metric_row( 'total_installed_cost,total_capital_cost_per_kw,total_capital_cost_kwh', {'label'='\u8d44\u672c\u6210\u672c', 'mode'='f,f,f', 'deci'='0,0,2', 'thousep'='true,true,true', 'pre'=' $,,', 'post'= ' , $/kW, $/kWh', 'tableName'='Table2' }); // Capital cost
		metric_row( 'device_costs_total,total_device_cost_per_kw,total_device_cost_kwh', {'label'='-  \u8bbe\u5907\u6210\u672c', 'mode'='f,f,f', 'deci'='0,0,2', 'thousep'='true,true,true', 'pre'=' $,,', 'post'= ' , $/kW, $/kWh', 'tableName'='Table2' }); // Device cost
		metric_row( 'balance_of_system_cost_total,total_bos_cost_per_kw,total_bos_cost_kwh', {'label'='-  \u7cfb\u7edf\u5e73\u8861\u6210\u672c', 'mode'='f,f,f', 'deci'='0,0,2', 'thousep'='true,true,true', 'pre'=' $,,', 'post'= ' , $/kW, $/kWh', 'tableName'='Table2' }); // Balance of system cost
		metric_row( 'financial_cost_total,total_financial_cost_per_kw,total_financial_cost_kwh', {'label'='-  \u8d22\u52a1\u6210\u672c', 'mode'='f,f,f', 'deci'='0,0,2', 'thousep'='true,true,true', 'pre'=' $,,', 'post'= ' , $/kW, $/kWh', 'tableName'='Table2' }); // Financial cost
		metric_row( 'total_operating_cost,total_operations_cost_per_kw,total_om_cost_kwh', {'label'='\u8fd0\u7ef4\u6210\u672c', 'mode'='f,f,f', 'deci'='0,0,2', 'thousep'='true,true,true', 'pre'=' $,,', 'post'= ' /\u5e74, $/kW/\u5e74, $/kWh', 'tableName'='Table2' }); // O&M cost
	}

}

function MEtidal_metrics()
{
	//metric_table('Table1', {'headers'='Metric,Value'});
	//me_lcoefcr_metrics();
	if(value('system_capacity') > 1) {
		metric( 'annual_energy', {'label'='\u5e74\u4ea7\u80fd', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'=' kWh', 'tableName'='Table1' } ); // Annual energy production
		metric( 'device_average_power', {'label'='\u6bcf\u8bbe\u5907\u5e73\u5747\u529f\u7387', 'mode'='f', 'deci'='0', 'thousep'='true','post'=' kW', 'tableName'='Table1' } ); // Average power per device
		metric( 'system_capacity', {'label'='\u7cfb\u7edf\u5bb9\u91cf', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'= ' kW', 'tableName'='Table1'}); // System capacity
		metric( 'capacity_factor', {'label'='\u5bb9\u91cf\u56e0\u5b50', 'mode'='f', 'deci'='0', 'thousep'='true', 'post'= ' %', 'tableName'='Table1'}); // Capacity factor
	}
	else {
		metric( 'annual_energy', {'label'='\u5e74\u4ea7\u80fd', 'mode'='f', 'deci'='3', 'thousep'='true', 'post'=' kWh', 'tableName'='Table1', 'scale'='1' } ); // Annual energy production
		metric( 'device_average_power', {'label'='\u6bcf\u8bbe\u5907\u5e73\u5747\u529f\u7387', 'mode'='f', 'deci'='3', 'thousep'='true','post'=' kW', 'tableName'='Table1','scale'='1' } ); // Average power per device
		metric( 'system_capacity', {'label'='\u7cfb\u7edf\u5bb9\u91cf', 'mode'='f', 'deci'='3', 'thousep'='true', 'post'= ' kW', 'tableName'='Table1','scale'='1'}); // System capacity
		metric( 'capacity_factor', {'label'='\u5bb9\u91cf\u56e0\u5b50', 'mode'='f', 'deci'='3', 'thousep'='true', 'post'= ' %', 'tableName'='Table1','scale'='1'}); // Capacity factor
	}
	if (financing() != "None") {
		metric_table('Table2', {'headers'='\u7c7b\u522b,\u6210\u672c,\u5355\u4f4d\u5bb9\u91cf\u6210\u672c,LCOE'}); // Category,Costs,Costs per capacity,LCOE
		metric_row( 'capital_cost,total_capital_cost_per_kw,total_capital_cost_kwh', {'label'='\u8d44\u672c\u6210\u672c', 'mode'='f,f,f', 'deci'='2,0,2', 'thousep'='true,true,true', 'post'= ' , $/kW, $/kWh', 'pre'='$,,','tableName'='Table2' }); // Capital cost
		metric_row( 'device_costs_total,total_device_cost_per_kw,total_device_cost_kwh', {'label'='-  \u8bbe\u5907\u6210\u672c', 'mode'='f,f,f', 'deci'='2,0,2', 'thousep'='true,true,true', 'post'= ' , $/kW, $/kWh', 'pre'='$,,','tableName'='Table2' }); // Device cost
		metric_row( 'balance_of_system_cost_total,total_bos_cost_per_kw,total_bos_cost_kwh', {'label'='-  \u7cfb\u7edf\u5e73\u8861\u6210\u672c', 'mode'='f,f,f', 'deci'='2,0,2', 'thousep'='true,true,true', 'post'= ' , $/kW, $/kWh','pre'='$,,', 'tableName'='Table2' }); // Balance of system cost
		metric_row( 'financial_cost_total,total_financial_cost_per_kw,total_financial_cost_kwh', {'label'='-  \u8d22\u52a1\u6210\u672c', 'mode'='f,f,f', 'deci'='2,0,2', 'thousep'='true,true,true', 'post'= ' , $/kW, $/kWh', 'pre'='$,,', 'tableName'='Table2' }); // Financial cost
		metric_row( 'total_operating_cost,total_operations_cost_per_kw,total_om_cost_kwh', {'label'='\u8fd0\u7ef4\u6210\u672c', 'mode'='f,f,f', 'deci'='2,0,2', 'thousep'='true,true,true', 'post'= ' /\u5e74, $/kW/\u5e74, $/kWh', 'pre'='$,,','tableName'='Table2' }); // O&M cost
	}
	//put $ in pre

	/*metric_table('Table3', {'headers'='Costs,Cost per Production, Cost per Capacity'});
	metric_row( 'total_capital_cost_per_kwh,total_capital_cost_per_kw', {'label'='Total capital cost', 'mode'='f,f', 'deci'='2,2', 'thousep'='true,true', 'post'= '$/kWh,$/kW', 'tableName'='Table3' });
	metric_row( 'total_device_cost_per_kwh,total_device_cost_per_kw', {'label'='-  Total device cost', 'mode'='f,f', 'deci'='2,2', 'thousep'='true,true', 'post'= '$/kWh,$/kW', 'tableName'='Table3' });
	metric_row( 'total_bos_cost_per_kwh,total_bos_cost_per_kw', {'label'='-  Total balance of system cost', 'mode'='f,f', 'deci'='2,2', 'thousep'='true,true', 'post'= '$/kWh,$/kW', 'tableName'='Table3' });
	metric_row( 'total_financial_cost_per_kwh,total_financial_cost_per_kw', {'label'='-  Total financial cost', 'mode'='f,f', 'deci'='2,2', 'thousep'='true,true', 'post'= '$/kWh,$/kW', 'tableName'='Table3' });
	metric_row( 'total_operations_cost_per_kwh,total_operations_cost_per_kw', {'label'='Total operating cost (annual)', 'mode'='f,f', 'deci'='2,2', 'thousep'='true,true', 'post'= '$/kWh,$/kW', 'tableName'='Table3' });*/

	/*metric_table('Table2', {'headers'='Costs,$ million, $/kW, LCOE'});
	metric_row( 'total_installed_cost_mill,total_capital_cost_per_kw,total_capital_cost_kwh', {'label'='Capital cost', 'mode'='f,f,f', 'deci'='2,0,2', 'thousep'='true,true,true', 'post'= '$mill,$/kW,$/kWh', 'tableName'='Table2' });
