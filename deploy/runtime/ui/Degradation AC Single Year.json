  "Callbacks": [
    "function display_warning()",
    "{",
    "\tdisplayflag = false;",
    "\tdcd = value('degradation');",
    "\tif (#dcd > 1 && dcd[0] != 0)",
    "\t{",
    "\t\tdisplayflag = true;",
    "\t}\t",
    "\tshow('degrad_sched_warning', displayflag);",
    "\trefresh();",
    "}",
    "",
    "on_load{'Degradation AC Single Year'} = define()",
    "{",
    "\tproperty('degradation','FixedLength',value('analysis_period'));",
    "\tdisplay_warning();",
    "};",
    "",
    "on_change{'degradation'} = define()",
    "{",
    "\tdisplay_warning();",
