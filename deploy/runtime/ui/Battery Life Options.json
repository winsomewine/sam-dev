  "VarDatabase": {
    "ui_batt_life_model": {
      "Version": 4.0,
      "Type": 1.0,
      "Label": "用户界面的电池寿命模型选项",
      "Units": "0/1/2",
      "Group": "Battery Life",
      "IndexLabels": "循环和日历退化|锂离子 NMC/石墨|锂离子 LMO/LTO",
      "Flags": 3.0,
      "DefaultValue": 0.0,
      "UIObject": "RadioChoice",
      "sscVariableName": "",
      "sscVariableValue": ""
    }
  },
  "Equations": [],
  "Callbacks": [
    "on_load{'Battery Life Options'} = define() {",
    "\tbattery_type_message();",
    "\tlife_message();",
    "\t// batt_life_model is set on battery life forms",
    "\t// for exclusive tabs for batt techs except fuel cell",
    "\tif ( technology()=='Fuel Cell' )",
    "\t{",
    "\t\tvalue('batt_life_model',${ui_batt_life_model});",
    "\t}",
    "};",
    "",
    "on_change{'ui_batt_life_model'} = define(){",
    "\tbattery_type_message();",
    "\tlife_message();",
    "\tif ( technology() != 'Fuel Cell' )",
    "\t{",
    "\t\tset_batt_life_excl_var();",
    "\t}\t",
    "\telse // fuel cell only",
    "\t{",
    "\t\tvalue('batt_life_model',${ui_batt_life_model});",
    "\t\tcycle_calendar_message();",
    "\t}",
    "};",
    "",
    "function set_batt_life_excl_var()",
    "{",
    "\tvalue('batt_life_excl', value('ui_batt_life_model'));",
    "}",
    "",
    "function life_message()",
    "{",
    "\tmsg = '';",
    "\tclr = 'Black';",
    "\t// options = ['Tables','Li-ion NMC/Graphite','Li-ion LMO/LTO'];\t",
    "\toptions = ['\\u8868\\u683c', '\\u9502\\u79bb\\u5b50 NMC/\\u77f3\\u58a8', '\\u9502\\u79bb\\u5b50 LMO/LTO']; // ['表格', '锂离子 NMC/石墨', '锂离子 LMO/LTO']",
    "\tif ( ${batt_chem} == 0 )",
    "\t{",
    "\t\t// msg = 'Only the Cycle and Calendar Degradation option is available for lead-acid and flow battery types.';",
    "\t\tmsg = '\\u5bf9\\u4e8e\\u94c5\\u9178\\u548c\\u6db2\\u6d41\\u7535\\u6c60\\u7c7b\\u578b\\uff0c\\u4ec5\\u201c\\u5faa\\u73af\\u548c\\u65e5\\u5386\\u9000\\u5316\\u201d\\u9009\\u9879\\u53ef\\u7528\\u3002'; // 对于铅酸和液流电池类型，仅“循环和日历退化”选项可用。",
    "\t}",
    "\telseif ( ${ui_batt_life_model} == 0 )",
    "\t{",
    "\t\t// msg = 'The Cycle and Calendar Degradation inputs below define battery degradation curves.';",
    "\t\tmsg = '\\u4e0b\\u65b9\\u7684\\u201c\\u5faa\\u73af\\u548c\\u65e5\\u5386\\u9000\\u5316\\u201d\\u8f93\\u5165\\u9879\\u5b9a\\u4e49\\u4e86\\u7535\\u6c60\\u9000\\u5316\\u66f2\\u7ebf\\u3002'; // 下方的“循环和日历退化”输入项定义了电池退化曲线。",
    "\t}",
    "\telse",
    "\t{",
    "\t\t// msg = 'This option uses a special battery life model for the ' + options[${ui_batt_life_model}] + ' battery type that combines cycle and calendar degradation.';",
    "\t\tmsg = '\\u6b64\\u9009\\u9879\\u4f7f\\u7528\\u4e00\\u79cd\\u7279\\u6b8a\\u7684\\u7535\\u6c60\\u5bff\\u547d\\u6a21\\u578b\\uff0c\\u9002\\u7528\\u4e8e ' + options[${ui_batt_life_model}] + ' \\u7535\\u6c60\\u7c7b\\u578b\\uff0c\\u7ed3\\u5408\\u4e86\\u5faa\\u73af\\u548c\\u65e5\\u5386\\u9000\\u5316\\u3002'; // 此选项使用一种特殊的电池寿命模型，适用于 ... 电池类型，结合了循环和日历退化。",
    "\t}",
    "\tproperty('lbl_batt_life_message','Caption',msg);",
    "\tproperty('lbl_batt_life_message','TextColour',clr);",
    "}",
    "",
    "function battery_type_message()",
    "{",
    "\tclr = 'Black';",
    "\tmsg = '';",
    "\t// types = ['Lead Acid: Flooded','Lead Acid: VRLA Gel','Lead Acid: VRLA AGM','Lead Acid: Custom','Lithium Ion: Lithium Manganese Oxide (LMO/Graphite)','Lithium Ion: Lithium Iron Phosphate (LFP/Graphite)','Lithium Ion: Lithium Cobalt Oxide (LCO/Graphite)','Lithium Ion: LMO/Lithium Titanate (LMO/LTO)','Lithium Ion: Nickel Manganese Cobalt Oxide (NMC/Graphite)','Lithium Ion: Nickel Cobalt Aluminum Oxide (NCA/Graphite)','Lithium Ion: Custom','Flow Battery: Vanadium','Flow Battery: Iron'];",
    "\ttypes = ['\\u94c5\\u9178: \\u5bcc\\u6db2\\u5f0f','\\u94c5\\u9178: VRLA \\u51dd\\u80f6','\\u94c5\\u9178: VRLA AGM','\\u94c5\\u9178: \\u81ea\\u5b9a\\u4e49','\\u9502\\u79bb\\u5b50: \\u9530\\u9178\\u9502 (LMO/\\u77f3\\u58a8)','\\u9502\\u79bb\\u5b50: \\u78f7\\u9178\\u94c1\\u9502 (LFP/\\u77f3\\u58a8)','\\u9502\\u79bb\\u5b50: \\u94b4\\u9178\\u9502 (LCO/\\u77f3\\u58a8)','\\u9502\\u79bb\\u5b50: LMO/\\u949b\\u9178\\u9502 (LMO/LTO)','\\u9502\\u79bb\\u5b50: \\u954d\\u9530\\u94b4\\u9178\\u9502 (NMC/\\u77f3\\u58a8)','\\u9502\\u79bb\\u5b50: \\u954d\\u94b4\\u94dd\\u9178\\u9502 (NCA/\\u77f3\\u58a8)','\\u9502\\u79bb\\u5b50: \\u81ea\\u5b9a\\u4e49','\\u6db2\\u6d41\\u7535\\u6c60: \\u9492','\\u6db2\\u6d41\\u7535\\u6c60: \\u94c1'];",
    "\t// types = ['铅酸: 富液式','铅酸: VRLA 凝胶','铅酸: VRLA AGM','铅酸: 自定义','锂离子: 锰酸锂 (LMO/石墨)','锂离子: 磷酸铁锂 (LFP/石墨)','锂离子: 钴酸锂 (LCO/石墨)','锂离子: LMO/钛酸锂 (LMO/LTO)','锂离子: 镍锰钴酸锂 (NMC/石墨)','锂离子: 镍钴铝酸锂 (NCA/石墨)','锂离子: 自定义','液流电池: 钒','液流电池: 铁'];",
    "",
    "\tif ( ${batt_chem} == 1 ) // Li-ion",
    "\t{",
    "\t\tif ( ${batt_type} == 7 ) // LMO/LTO",
    "\t\t{",
    "\t\t\t// best_life = 'Li-ion LMO/LTO';",
    "\t\t\tbest_life = '\\u9502\\u79bb\\u5b50 LMO/LTO'; // 锂离子 LMO/LTO",
    "\t\t\tif ( ${ui_batt_life_model} != 2 ) { clr = 'Red'; }",
    "\t\t}",
    "\t\telseif ( ${batt_type} == 8 ) // NMC/Graphite",
    "\t\t{",
    "\t\t\t// best_life = 'Li-ion NMC/Graphite';",
    "\t\t\tbest_life = '\\u9502\\u79bb\\u5b50 NMC/\\u77f3\\u58a8'; // 锂离子 NMC/石墨",
    "\t\t\tif ( ${ui_batt_life_model} != 1 ) { clr = 'Red'; }",
    "\t\t}",
    "\t\telse // other Li-ion types",
    "\t\t{",
    "\t\t\t// best_life = 'empirical cycle and calendar degradation';",
    "\t\t\tbest_life = '\\u7ecf\\u9a8c\\u5faa\\u73af\\u548c\\u65e5\\u5386\\u9000\\u5316'; // 经验循环和日历退化",
    "\t\t\tif ( ${ui_batt_life_model} != 0 || ${batt_calendar_choice} != 1 ) { clr = 'Red'; }",
    "\t\t}",
    "\t}",
    "\telse // lead acid and flow",
    "\t{",
    "\t\t// best_life = 'cycle degradation';",
    "\t\tbest_life = '\\u5faa\\u73af\\u9000\\u5316'; // 循环退化",
    "\t\tif ( ${ui_batt_life_model} != 0 || ${batt_calendar_choice} != 0 ) { clr = 'Red'; }",
    "\t}",
    "\t// msg += 'The best battery life option for ' + types[${batt_type}] + ' (batt_type='+ ${batt_type}+')' + ' is ' + best_life + '.';",
    "\tmsg += '\\u9002\\u7528\\u4e8e ' + types[${batt_type}] + ' (\\u7535\\u6c60\\u7c7b\\u578b='+ ${batt_type}+')' + ' \\u7684\\u6700\\u4f73\\u7535\\u6c60\\u5bff\\u547d\\u9009\\u9879\\u662f ' + best_life + '\\u3002'; // 适用于 ... (电池类型=...) 的最佳电池寿命选项是 ...。",
    "\t// if ( clr == 'Red' ) { msg+=' Choose the appropriate battery life options here or reselect the battery type on the Battery Cell and System page to reset to the default options.'; }",
    "\tif ( clr == 'Red' ) { msg+=' \\u8bf7\\u5728\\u6b64\\u5904\\u9009\\u62e9\\u9002\\u5f53\\u7684\\u7535\\u6c60\\u5bff\\u547d\\u9009\\u9879\\uff0c\\u6216\\u5728\\u201c\\u7535\\u6c60\\u5355\\u5143\\u548c\\u7cfb\\u7edf\\u201d\\u9875\\u9762\\u4e0a\\u91cd\\u65b0\\u9009\\u62e9\\u7535\\u6c60\\u7c7b\\u578b\\u4ee5\\u91cd\\u7f6e\\u4e3a\\u9ed8\\u8ba4\\u9009\\u9879\\u3002'; } // 请在此处选择适当的电池寿命选项，或在“电池单元和系统”页面上重新选择电池类型以重置为默认选项。",
    "\tproperty('lbl_batt_chem','Caption',msg);",
    "\tproperty('lbl_batt_chem','TextColour',clr);",
    "}",
    ""
  ]
}
