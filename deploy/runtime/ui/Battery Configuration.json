  "Equations": [
    "equations{'batt_ui_inverter_eff'} = define() {",
    "\t// note PVWatts default inv_eff set to 96% in cmod_pvwattsv7.cpp var table",
    "\tif ( technology() != '\\u5149\\u4F0D\\u7535\\u6C60' ) { return 96; }\t// 注意：PVWatts默认inv_eff在cmod_pvwattsv7.cpp变量表中设置为96%", 
    "\tinv_model = ${inverter_model};",
    "\tif (inv_model == 0){ return ${inv_snl_eff_cec};\t\t}",
    "\telseif (inv_model == 1) { return ${inv_ds_eff}; }",
    "\telseif (inv_model == 2) { return ${inv_pd_eff}; }",
    "\telseif (inv_model == 3) { return ${inv_cec_cg_eff_cec}; }",
    "\telse { return 96; } ",
    "};"
  ],
  "Callbacks": [
    "on_load{'Battery Configuration'} = define()",
    "{",
    "\tmsg = '';",
    "\t// for ac-only configs, set to AC-connected",
    "\tif ( !is_dc_tech() ) // \\u4EC5\\u4EA4\\u6D41\\u8FDE\\u63A5// 仅交流连接", 
    "\t{",
    "\t\tvalue('batt_ac_or_dc',1);",
    "\t\tmsg = '\\u8BBE\\u7F6E\\u7535\\u6C60\\u8F6C\\u6362\\u5668\\u7684\\u4EA4\\u6D41\\u8F6C\\u76F4\\u6D41\\u548C\\u76F4\\u6D41\\u8F6C\\u4EA4\\u6D41\\u8F6C\\u6362\\u6548\\u7387\\u3002\\u76F4\\u6D41\\u8FDE\\u63A5\\u7684\\u7535\\u6C60\\u4EC5\\u5728\\u5149\\u4F0D\\u7535\\u6C60\\u914D\\u7F6E\\u4E2D\\u53EF\\u7528\\u3002'; // 设置电池转换器的交流转直流和直流转交流转换效率。直流连接的电池仅在光伏电池配置中可用。",
    "\t}",
    "\telse // \\u5149\\u4F0D\\u7535\\u6C60\\u53EF\\u4EE5\\u662F\\u76F4\\u6D41\\u6216\\u4EA4\\u6D41\\u8FDE\\u63A5// 光伏电池可以是直流或交流连接", 
    "\t{",
    "\t\tmsg = '\\u5BF9\\u4E8E\\u5149\\u4F0D\\u7535\\u6C60\\u914D\\u7F6E\\uFF0C\\u7535\\u6C60\\u53EF\\u4EE5\\u8FDE\\u63A5\\u5230\\u5149\\u4F0D\\u9006\\u53D8\\u5668\\u7684\\u76F4\\u6D41\\u6216\\u4EA4\\u6D41\\u4FA7\\u3002'; // 对于光伏电池配置，电池可以连接到光伏逆变器的直流或交流侧。",
    "\t}",
    "\tproperty('lbl_dc_ac','Caption',msg);\t",
    "\tenable_inputs();",
    "};",
    "",
    "on_change{'batt_ac_or_dc'} = define()",
    "{",
    "\tenable_inputs();",
    "\tif (is_dc_tech() && behind_the_meter()) {",
    "\t\tenable_disable_powerflow_options();",
    "\t}",
    "};",
    "",
    "function is_dc_tech()",
    "{",
    "\ttech = technology();",
    "\treturn (tech == '\\u5149\\u4F0D\\u7535\\u6C60');// '光伏电池'", 
    "}",
    "",
    "function enable_inputs()",
    "{",
    "\tif ( is_dc_tech() ) ",
    "\t{",
    "\t\tenable('batt_ac_or_dc',true);",
    "\t\tisdc = ( value('batt_ac_or_dc') == 0 );",
    "\t\tenable('batt_dc_dc_efficiency', isdc);",
    "\t\tenable('batt_inverter_efficiency_cutoff',isdc);",
    "\t\tenable('batt_ui_inverter_eff',isdc);",
    "\t\tenable('batt_ac_dc_efficiency', !isdc);",
    "\t\tenable('batt_dc_ac_efficiency', !isdc);",
    "\t\t",
    "\t\tif (isdc) { msg = '\\u76F4\\u6D41\\u8FDE\\u63A5\\u7684\\u7535\\u6C60\\u5F53\\u5149\\u4F0D\\u9006\\u53D8\\u5668\\u8FD0\\u884C\\u6548\\u7387\\u4F4E\\u4E8E\\u9006\\u53D8\\u5668\\u6548\\u7387\\u622A\\u6B62\\u503C\\u65F6\\uFF0C\\u5C06\\u505C\\u6B62\\u5145\\u7535\\u6216\\u653E\\u7535\\u3002'; // 直流连接的电池当光伏逆变器运行效率低于逆变器效率截止值时，将停止充电或放电。",
    "\t\telse { msg = ''; }",
    "\t\tproperty('lbl_dc_connected','Caption',msg);",
    "\t}",
    "\telse",
    "\t{",
    "\t\tenable('batt_ac_or_dc',false);",
    "\t\tenable('batt_dc_dc_efficiency',false);",
    "\t\tenable('batt_inverter_efficiency_cutoff',false);",
    "\t\tenable('batt_ui_inverter_eff',false);",
    "\t}",
    "}",
    ""
  ]
}
