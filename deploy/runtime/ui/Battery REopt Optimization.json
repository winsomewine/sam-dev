  "VarDatabase": {
    "reopt_consider_outage": {
      "Version": 4.0,
      "Type": 1.0,
      "Label": "在 REopt 优化中考虑电网中断",
      "Units": "",
      "Group": "Battery REopt Optimization",
      "IndexLabels": "",
      "Flags": 1.0,
      "DefaultValue": 0.0,
      "UIObject": "CheckBox",
      "sscVariableName": "",
