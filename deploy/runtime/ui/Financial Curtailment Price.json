  "Equations": [],
  "Callbacks": [
    "function curtailment_price_ctrl_refresh()",
    "{",
    "\tshow_escalation = (#${grid_curtailment_price} < 2);",
    "\t// show/hide example",
    "\t/*",
    "\tshow(\"grid_curtailment_group\",show_escalation);",
    "\tshow(\"grid_curtailment_label\",show_escalation);",
    "\tshow(\"grid_curtailment_price_esc\",show_escalation);",
    "\trefresh();",
    "\t*/",
    "\t// enable disable",
    "\tenable(\"grid_curtailment_price_esc\",show_escalation);",
    "}",
    "",
    "on_load{\"Financial Curtailment Price\"}=define()",
    "{",
    "\tcurtailment_price_ctrl_refresh();\r",
    "\tchange_curtailment_price_length();",
    "};\t",
    "",
    "on_change{\"grid_curtailment_price\"}=define()",
    "{",
    "\tcurtailment_price_ctrl_refresh();",
    "};\r",
    "",
    "function change_curtailment_price_length() {",
    "\tproperty('grid_curtailment_price', 'FixedLength', value('analysis_period'));",
    "}",
    ""
