  "Equations": [
    "equations{ 'ui_wacc' } = define() {",
    "  return 100 ",
    "    * ( ( (1+${real_discount_rate}/100)",
    "          * (1+${inflation_rate}/100) ",
    "        - 1 )",
    "    * (1-${debt_percent}/100)",
    "      + (1-(${federal_tax_rate}[0]/100",
    "    * (1-${state_tax_rate}[0]/100)",
    "      + ${state_tax_rate}[0]/100))",
    "    * ${term_int_rate}/100",
    "    * ${debt_percent}/100); ",
    "};",
    "",
    ""
  ],
  "Callbacks": [
    "on_load{'Financial Debt DSCR or Debt Fraction'} = define() {",
    "\ton_change{'debt_option'}();",
    "\ton_change{'debt_percent'}();",
    "\ton_change{'dscr'}();",
    "\ton_change{'cost_debt_closing'}();",
    "\ton_change{'term_tenor'}();",
    "\tdebt_messages();",
    "",
    "\trefresh();",
    "};",
    "",
    "function debt_messages() {",
    "  // Logic for Closing Cost Warning",
    "  no_debt = (value('debt_option')==0 && value('debt_percent')==0) || ",
    "            (value('debt_option')==1 && value('dscr')==0);",
    "  show_closing_warning = ( no_debt && value('cost_debt_closing')!=0 );",
    "  show('lbl_warn_closing', show_closing_warning);",
    "  ",
    "  // Logic for Tenor Warning",
    "  fin = financing();",
    "  debt = true;",
    "  if ( fin == 'All Equity Partnership Flip' || fin == 'Sale Leaseback' ) {",
    "    debt = false;",
    "  }",
    "  show_tenor_warning = false;",
    "  if ( debt == true ) {",
    "    if ( fin == 'Residential' || fin == 'Commercial' ) {",
    "      if ( value('loan_term') > value('analysis_period') && value('debt_fraction') > 0 ) {",
    "        show_tenor_warning = true;",
    "      }  ",
    "    }  ",
    "    else {",
    "      ppa_debt = (value('debt_option') == 1 && value('dscr') > 0) || (value('debt_option')==0 && value('debt_percent')) > 0;",
    "      if ( value('term_tenor') > value('analysis_period') && ppa_debt==true ) {",
    "        show_tenor_warning = true;",
    "      }  ",
    "    }        ",
    "  }",
    "  show('lbl_warn_tenor', show_tenor_warning);",
    "}",
    "",
    "on_change{'dscr_limit_debt_fraction'} = define() {",
    "\tdscr_limit_debt_fraction = value(\"dscr_limit_debt_fraction\");",
    "\tenable('dscr_maximum_debt_fraction',dscr_limit_debt_fraction==1);",
    "};",
    "",
    "on_change{'debt_option'} = define() {",
    "\tdebt_option = value('debt_option');",
    "\tenable('debt_percent',debt_option==0);",
    "\tenable('payment_option',debt_option==0);",
    "\tenable('loan_moratorium',debt_option==0);",
    "\tshow('ui_wacc',debt_option==0);",
    "\tshow('wacc_message',debt_option==0);",
    "\trefresh();",
    "\tenable('dscr',debt_option==1);",
    "\tenable('dscr_limit_debt_fraction',debt_option==1);",
    "\tdscr_limit_debt_fraction = value(\"dscr_limit_debt_fraction\");",
    "\tenable('dscr_maximum_debt_fraction',debt_option==1 && dscr_limit_debt_fraction==1);",
    "\tdebt_messages();",
    "};",
    "",
    "on_change{'debt_percent'} = define() {",
    "\tdebt_messages();",
    "};",
    "",
    "on_change{'dscr'} = define() {",
    "\tdebt_messages();",
    "};",
    "",
    "on_change{'cost_debt_closing'} = define() {",
    "\tdebt_messages();",
    "};",
    "",
    "on_change{'term_tenor'} = define() {",
    "\tdebt_messages();",
    "};"
  ]
}
