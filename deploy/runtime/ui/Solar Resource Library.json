  "Callbacks": [
    "on_load{'Solar Resource Library'} = define() {",
    "\tenable_user_specified_wf();\r",
    "\tupdate_library_folders(''); \r",
    "\tlibrary_notification();\r",
    "};",
    "",
    "on_change{'btn_refresh_library'} = define() {",
    "\trescanlibrary( 'solar' );\r",
    "\tlibrary_notification();",
    "};",
    "",
    "on_change{'btn_add_remove_folders'} = define() {",
    "\tif ( showsettings( 'solar' ) ) {",
    "\t\tupdate_library_folders( '' );",
    "\t}\r",
    "\telse {\r",
    "\t\tmsgbox('无法打开太阳能资源数据文件夹设置窗口。');\r",
    "\t}\r",
    "\tlibrary_notification();\r",
    "};",
    "\r",
    "on_change{'btn_browse_file'} = define() {\r",
    "\tf_current = value('user_specified_weather_file');\r",
    "\tif ( !file_exists(f_current) ) {\r",
    "\t\tfpath = homedir();\r",
    "\t}\r",
    "\telse {\r",
    "\t\tfpath = path_only( f_current );\r",
    "\t}\r",
    "\t\r",
    "\tf = choose_file( fpath , '选择气象文件', '气象文件 (*.csv, *.epw, *.tm2)|*.csv; *.epw; *.tm2');\r",
    "\t\t\r",
    "\tif ( f != '' ) {\r",
    "\t\tf = replace(f, '\\\\', '/');\r",
    "\t\tvalue( 'user_specified_weather_file', f );\r",
    "\t}\r",
    "};\r",
    "\r",
    "on_change{'use_specific_weather_file'} = define() {\r",
    "\tenable_user_specified_wf();\r",
    "\tlibrary_notification();\r",
    "};\r",
    "\r",
    "function enable_user_specified_wf() {\r",
    "\tis_user_specified = ( value('use_specific_weather_file') == 1 );\r",
    "\tenable('user_specified_weather_file', is_user_specified );\r",
    "\tenable('btn_browse_file', is_user_specified );\r",
    "\tenable('solar_resource', !is_user_specified );\r",
    "\tenable('solar_data_file_name', !is_user_specified );\r",
    "\tenable('library_folder_list', !is_user_specified );\r",
    "\tenable('btn_add_remove_folders', !is_user_specified );\r",
    "\tenable('btn_refresh_library', !is_user_specified );\r",
    "}\r",
    "\r",
    "function update_library_folders( new_path )\r",
    "{\r",
    "\tx = get_settings('solar_data_paths');\r",
    "\tif ( new_path != '' && dir_exists( new_path ) && ( strpos( x, new_path ) < 0 ) )\r",
    "\t{\r",
    "\t\tif ( x != '' ) { x += ';'; }\r",
    "\t\tx += replace( new_path, '\\\\', '/' );\r",
    "\t}\r",
    "\tpaths = split( x, ';' );\r",
    "\tclean_list = '';\r",
    "\tfor (i = 0; i<#paths; i++ )\r",
    "\t{\r",
    "\t\tif ( dir_exists( paths[i] ) )\r",
    "\t\t{\r",
    "\t\t\tclean_list += paths[i];\r",
    "\t\t\tif ( i < #paths-1 ) { clean_list += ';'; }\r",
    "\t\t}\t\r",
    "\t}\t\t\r",
    "\tset_settings('solar_data_paths', clean_list );\r",
    "\tvalue( 'library_folder_list', get_settings('solar_download_path') + '\\n' \r",
    "\t       + replace( clean_list , ';' , '\\n' ) );\r",
    "\trescanlibrary( 'solar' );        \r",
    "}\r",
    "\r",
    "function library_notification() {\r",
    "\r",
    "\tsam_dir = replace(appdir(),'\\\\','/'); \r",
    "\tdefault_solar_resource_path = left(sam_dir,last_of(sam_dir,'/'))+'/solar_resource'; \r",
    "\tdefault_files = dir_list(default_solar_resource_path, '*');\r",
    "\tlib = csvread(userlocaldatadir() + '/SolarResourceData.csv', {'skip'=3});\r",
    "\r",
    "\t// Hide all error labels initially\r",
    "\tshow('lbl_msg_no_selection', false);\r",
    "\tshow('lbl_msg_invalid_selection', false);\r",
    "\tshow('lbl_msg_no_match', false);\r",
    "\tshow('lbl_msg_diff_selection', false);\r",
    "\tshow('lbl_msg_no_files', false);\r",
    "\t// Clear built-in notification area to avoid question marks\r",
    "\tlibrarynotifytext('solar_resource', '');\r",
    "\r",
    "\t// Always show enabled text by default unless disabled mode overrides it\r",
    "\t\r",
    "\tif (value('use_specific_weather_file') == 1) {\r",
    "\t\tshow('lbl_library_enabled', false);\r",
    "\t\tshow('lbl_library_disabled', true);\r",
    "\t}\r",
    "\telse {\r",
    "\t\tshow('lbl_library_disabled', false);\r",
    "\t\t\r",
    "\t\tif ( librarygetcurrentselection('solar_resource') == '' ) {\r",
    "\t\t\tshow('lbl_msg_no_selection', true);\r",
    "\t\t}\r",
    "\t\telseif ( strpos( replace(value('solar_data_file_name'),'\\\\','/'), replace(value('solar_resource'),'\\\\','/')  ) < 0) {\r",
    "\t\t\tshow('lbl_msg_invalid_selection', true);\r",
    "\t\t}\r",
    "\t\telseif (librarygetnumbermatches('solar_resource') < 1) {\r",
    "\t\t\tshow('lbl_msg_no_match', true);\r",
    "\t\t}\r",
    "\t\telseif ( replace(value('solar_data_file_name'), '\\\\', '/') != replace( value('solar_resource_file'), '\\\\', '/' ) ) {\r",
    "\t\t\tshow('lbl_msg_diff_selection', true);\r",
    "\t\t}\r",
    "\t\telseif ( #lib ==  #default_files ) {\r",
    "\t\t\tshow('lbl_msg_no_files', true);\r",
    "\t\t}\r",
    "\t\t\r",
    "\t\tshow('lbl_library_enabled', true);\r",
    "\t}\r",
    "}\r",
    ""
  ]
