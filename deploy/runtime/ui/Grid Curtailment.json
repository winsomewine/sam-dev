  "Callbacks": [
    "on_load{'Grid Curtailment'} = define() {",
    "\tcheck_grid_curtailment_fin();",
    "};",
    "",
    "function check_grid_curtailment_fin()",
    "{",
    "\tis_compensated = (financing() == 'Merchant Plant' || financing() == 'Single Owner' );",
    "\tif ( is_compensated )",
    "\t{",
    "\t\tproperty('lbl_curtailment_compensated', 'Visible', 1);",
    "\t\tproperty('lbl_curtailment_uncompensated', 'Visible', 0);",
    "\t}",
    "\telse",
    "\t{",
    "\t\tproperty('lbl_curtailment_compensated', 'Visible', 0);",
    "\t\tproperty('lbl_curtailment_uncompensated', 'Visible', 1);",
    "\t}",
    "\trefresh();",
    "}"
  ]
