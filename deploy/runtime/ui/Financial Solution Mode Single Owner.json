  "Callbacks": [
    "// This form is a copy of Financial Solution Flip Leaseback",
    "// so ppa_soln_mode radio button can have different labels",
    "// to indicate IRR target is for the tax investor for flip ",
    "// structures. Any updates should be made to both forms.",
    "",
    "on_load{'Financial Solution Mode Single Owner'} = define()",
    "{",
    "\tsoln_mode_ctrl_refresh();",
    "\tif (is_assigned('en_batt') && value('en_batt') != 0 && financing() != \"Host Developer\") {",
    "\t\tcheck_auto_ppa();",
    "\t}",
    "\tdisplay_message();",
    "\ton_change{'ppa_soln_mode'};",
    "};",
    "",
    "on_change{'ppa_soln_mode'} = define()",
    "{",
    "\tsoln_mode_ctrl_refresh();",
    "\tif (is_assigned('en_batt') && value('en_batt') != 0 && financing() != \"Host Developer\") {",
    "\t\tcheck_auto_ppa();",
    "\t}",
    "\tdisplay_message();",
    "};",
    "",
    "on_change{'ppa_price_input'} = define()",
    "{",
    "\tsoln_mode_ctrl_refresh();",
    "};",
    "",
    "on_change{'flip_target_year'} = define () {",
    "\tdisplay_message();",
    "};",
    "",
    "function display_message() ",
    "{",
    "\t// Messages are handled by static labels (see FormObjects)",
    "\t// Hide all first",
    "\tshow('lbl_msg_irr_year_err', 0);",
    "\tshow('lbl_msg_irr_year_err_host_dev', 0);",
    "\tshow('lbl_msg_irr_year_err_community', 0);",
    "\tshow('lbl_msg_irr_year_err_conflict', 0);",
    "\tshow('lbl_msg_host_dev', 0);",
    "\tshow('lbl_msg_community', 0);",
    "\tshow('lbl_msg_conflict', 0);",
    "\t",
    "\tis_irr_year_err = ( value('flip_target_year') > value('analysis_period') );",
    "\tis_host_dev = ( financing() == 'Host Developer' );",
    "\tis_community = ( financing() == 'Community Solar' );",
    "\tis_conflict = ( value('ppa_soln_mode') == 0 && value('en_electricity_rates') == 0 );",
    "\t",
    "\tif (is_irr_year_err)",
    "\t{",
    "\t\tif (is_host_dev) show('lbl_msg_irr_year_err_host_dev', 1);",
    "\t\telseif (is_community) show('lbl_msg_irr_year_err_community', 1);",
    "\t\telseif (is_conflict) show('lbl_msg_irr_year_err_conflict', 1);",
    "\t\telse show('lbl_msg_irr_year_err', 1);",
    "\t}",
    "\telse",
    "\t{",
    "\t\tif (is_host_dev) show('lbl_msg_host_dev', 1);",
    "\t\telseif (is_community) show('lbl_msg_community', 1);",
    "\t\telseif (is_conflict) show('lbl_msg_conflict', 1);",
    "\t}",
    "}",
    "",
    "function soln_mode_ctrl_refresh()",
    "{",
    "    is_specify_irr = ( value('ppa_soln_mode') == 0 );",
    "    enable( 'flip_target_percent', is_specify_irr );",
    "    enable( 'ppa_price_input', !is_specify_irr );",
    "\tshow_escalation = (#${ppa_price_input} < 2);",
    "\tenable(\"ppa_escalation\",(show_escalation || is_specify_irr));",
    "}\r",
    "\r",
    "\r",
    "function check_auto_ppa()\r",
    "{\r",
    "\tdispatch = value('batt_dispatch_choice_ui');\r",
    "\tif (dispatch == 0 && value('en_batt') != 0 && financing() != \"Merchant Plant\") \r",
    "\t{\r",
    "\t\tppa_mode = value('ppa_soln_mode');\r",
    "\t\tif (ppa_mode == 0) {\r",
    "\t\t\tmsgbox('Specify IRR Target not available for automated dispatch.\\nThe automated battery dispatch options require the Specify PPA Price option on the Revenue or Financial Parameters page.\\n\\nPlease change Specify IRR Target to Specify PPA Price and specify a PPA price and optional escalation rate to use the Automated Dispatch options.');\r",
    "\t\t}\r",
    "\t}\r",
    "}\r",
    ""
  ]
}
