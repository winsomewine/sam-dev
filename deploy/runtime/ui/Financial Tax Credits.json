  "Equations": [],
  "Callbacks": [
    "on_load{\"Financial Tax Credits\"}=define()",
    "{",
    "\tf = financing();",
    "\t",
    "\tshow( 'itc_fed_amount_deprbas_fed', f!='Residential' );",
    "\tshow( 'itc_fed_amount_deprbas_sta', f!='Residential' );",
    "\tshow( 'itc_sta_amount_deprbas_fed', f!='Residential' );",
    "\tshow( 'itc_sta_amount_deprbas_sta', f!='Residential' );",
    "\tshow( 'itc_fed_percent_deprbas_fed', f!='Residential' );",
    "\tshow( 'itc_fed_percent_deprbas_sta', f!='Residential' );",
    "\tshow( 'itc_sta_percent_deprbas_fed', f!='Residential' );",
    "\tshow( 'itc_sta_percent_deprbas_sta', f!='Residential');",
    "\t",
    "\tshow( \"lblReducesDeprBasis\", f!='Residential' );",
    "\tshow( \"lblFederal\", f!='Residential' );",
    "\tshow( \"lblState\", f!='Residential' );",
    "\t",
    "\tproperty('itc_fed_amount','FixedLength',value('analysis_period'));",
    "\tproperty('itc_sta_amount','FixedLength',value('analysis_period'));",
    "\tproperty('itc_fed_percent','FixedLength',value('analysis_period'));",
    "\tproperty('itc_sta_percent','FixedLength',value('analysis_period'));",
    "\tproperty('itc_fed_percent_maxvalue','FixedLength',value('analysis_period'));",
    "\tproperty('itc_fed_percent_maxvalue','FixedLength',value('analysis_period'));",
    "\tproperty('ptc_fed_amount','FixedLength',value('analysis_period'));",
    "\tproperty('ptc_sta_amount','FixedLength',value('analysis_period'));",
    "\r",
    "\tptc_grid_charge_message();\r",
    "",
    "};\r",
    "\r",
    "on_change{'ptc_fed_amount'} = define() { ptc_grid_charge_message(); };\r",
    "on_change{'ptc_fed_term'} = define() { ptc_grid_charge_message(); };\r",
    "on_change{'ptc_sta_amount'} = define() { ptc_grid_charge_message(); };\r",
    "on_change{'ptc_sta_term'} = define() { ptc_grid_charge_message(); };\r",
    "\r",
    "function ptc_grid_charge_message() {\r",
    "\tptc_enabled = ( sum(value('ptc_fed_amount')) != 0 && value('ptc_fed_term') > 0 ) || ( sum(value('ptc_sta_amount')) != 0 && value('ptc_sta_term') > 0 );\r",
    "\tgridcharge_enabled = false;\r",
    "\tif ( is_assigned('batt_dispatch_choice') ) {\r",
    "\t\tif ( value('batt_dispatch_choice') == 3 ) { // manual dispatch\r",
    "\t\t\tgridcharge_enabled = value('pv.storage.p1.gridcharge') \r",
    "\t\t\t\t\t\t  || value('pv.storage.p2.gridcharge')\r",
    "\t\t\t\t\t\t  || value('pv.storage.p3.gridcharge') \r",
    "\t                      || value('pv.storage.p4.gridcharge') \r",
    "\t                      || value('pv.storage.p5.gridcharge') \r",
    "\t                      || value('pv.storage.p6.gridcharge');\r",
    "\t\t}\r",
    "\t\telse { // all other dispatch options have grid charge option\r",
    "\t\t\tgridcharge_enabled = value('batt_dispatch_auto_can_gridcharge');\r",
    "\t\t}\r",
    "\t}\r",
    "\t\r",
    "\t// Logic to toggle labels instead of setting text\r",
    "\tis_warning = (gridcharge_enabled && ptc_enabled);\r",
    "\t\r",
    "\tshow('lbl_ptc_message_normal', !is_warning);\r",
    "\tshow('lbl_ptc_message_warning', is_warning);\r",
    "}",
    "\t\t",
    ""
  ]
}
