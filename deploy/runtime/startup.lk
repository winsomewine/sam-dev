// NEW Molten Salt Linear Fresnel ////////////////////////////////////////////////////////////////////
function setup_MSLF_pages()
{
	addpage( [[ 'Solar Resource Download', 'Solar Resource Library', 'Solar Resource Information' ]], { 'sidebar'='\u4f4d\u7f6e\u548c\u8d44\u6e90', 'help'='mslf_location_and_resource' } );
	addpage( [[ 'MSLF System Design' ]], { 'sidebar'='\u7cfb\u7edf\u8bbe\u8ba1', 'help'='mslf_system_design' } );
	addpage( [[ 'MSLF Solar Field' ]], { 'sidebar'='\u592a\u9633\u80fd\u573a', 'help'='mslf_solar_field' } );

	addpage( [[ 'MSLF Collector and Receiver' ]],
		{ 'sidebar'='\u96c6\u70ed\u5668\u548c\u63a5\u6536\u5668', 'help'='mslf_collector_and_receiver' } );

	addpage( [[ 'Rankine Cycle' ], [ 'User Defined Power Cycle' ]],
		{ 'sidebar'='\u52a8\u529b\u5faa\u73af', 'help'='mslf_power_cycle', 'exclusive_var' = 'pc_config',
		'exclusive_header_pages' = ['MSLF Power Cycle Common']} );

	addpage( [[ 'MSLF Storage' ]], { 'sidebar'='\u50a8\u70ed', 'help'='mslf_thermal_storage' } );

	addpage( [[ 'MSLF System Control' ,
		{'name' = 'MSLF Dispatch Control', 'caption'='Dispatch Control', 'collapsible'=false, 'collapsible_var'='csp_dispatch_is_shown'} ]],
		{ 'sidebar'='\u7cfb\u7edf\u63a7\u5236', 'help'='mslf_system_control' } );
		
 	setup_grid_limits_page();
}

