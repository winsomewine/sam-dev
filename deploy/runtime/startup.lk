function setup_pvwatts_battery_pages(is_btm)
{
	addpage( [[ 'Solar Resource Download', 'Solar Resource Library', 'Solar Resource Information' ]], { 'sidebar'='\u4f4d\u7f6e\u548c\u8d44\u6e90', 'help'='pvwatts_location_and_resource', 'bin_name'='PVWatts' } );
	addpage( [[ 'PVWatts',
	            {'name'='PV Land Area', 'caption' = '\u571f\u5730\u9762\u79ef', 'collapsible'=true, 'collapsible_var'='pv_land_area_is_shown'},
	            {'name'='PVWatts Advanced Inputs', 'caption' = '\u9ad8\u7ea7\u8f93\u5165', 'collapsible'=true, 'collapsible_var'='pvwatts.advanced.is_shown'},
	            'Battery Enable' ]],
	            { 'sidebar'='\u7cfb\u7edf\u8bbe\u8ba1', 'help'='pvwatts_system_design', 'bin_name'='PVWatts' } );
	
	if (is_btm)
	{
		setup_pages_battery_cell_and_system(true,true); // REopt and BTM
		setup_pages_battery_life();
		setup_pages_battery_dispatch_btm();
		setup_grid_limits_page();
		setup_grid_outage_page();
	}
	else
	{
		setup_pages_battery_cell_and_system(false, false); // No REopt and FOM
		setup_pages_battery_life();
		setup_pages_pv_battery_dispatch_fom();
		setup_grid_limits_page();
	}            
}

