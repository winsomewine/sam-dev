addpage( [[ 'Financial LCOE Calc with Costs Page']], { 'sidebar'='\u8d22\u52a1\u53c2\u6570', 'help'='fin_lcoefcr'} );

setconfig( 'MEtidal', 'None' );
setmodules( ['tidal_file_reader', 'mhk_tidal'] );
setup_metidal_pages(0);

