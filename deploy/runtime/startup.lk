function setup_MSPT_pages(is_grid_limits)
{
	addpage( [[ 'Solar Resource Download', 'Solar Resource Library', 'Solar Resource Information' ]], { 'sidebar'='\u4f4d\u7f6e\u548c\u8d44\u6e90', 'help'='pt_location_and_resource' } );
	addpage( [[ 'MSPT System Design' ]], { 'sidebar'='\u7cfb\u7edf\u8bbe\u8ba1', 'help'='mspt_system_design' } );
	addpage( [[ 'Tower SolarPilot Solar Field' ]], { 'sidebar'='\u5b9a\u65e5\u955c\u573a', 'help'='mspt_heliostat_field' } );
	addpage( [[ 'MSPT Receiver External' ], [ 'MSPT Receiver Cavity' ]],
			{ 'sidebar'='\u5854\u548c\u63a5\u6536\u5668', 'help'='mspt_tower_and_receiver', 'exclusive_var'='receiver_type',
			'exclusive_header_pages' = ['MSPT Receiver']} );
	addpage( [[ 'MSPT Parallel Heater' ]], { 'sidebar'='\u7535\u52a0\u70edHTF\u52a0\u70ed\u5668', 'help' = 'mspt_electric_htf_heater' } );
	addpage( [[ 'Rankine Cycle' ], [ 'User-Defined Power Cycle' ]],
			{ 'sidebar'='\u52a8\u529b\u5faa\u73af', 'help'='mspt_power_cycle', 'exclusive_var' = 'pc_config',
			  'exclusive_header_pages' = ['Molten Salt Tower Power Block Common']} );
	addpage( [[ 'TES Direct Two Tank' ]], { 'sidebar'='\u50a8\u70ed', 'help'='mspt_thermal_storage' } );
	addpage( [[ 'MSPT System Control' ,
	  {'name' = 'MSPT Dispatch Control', 'caption'='Dispatch Control', 'collapsible'=false, 'collapsible_var'='csp_dispatch_is_shown'} ]],
	  { 'sidebar'='\u7cfb\u7edf\u63a7\u5236', 'help'='mspt_system_control' } );
  	if(is_grid_limits == 1){
		setup_grid_limits_page();
  	}
}

function setup_MSPT_IPH_pages()
{
	addpage( [[ 'Solar Resource Download', 'Solar Resource Library', 'Solar Resource Information' ]], { 'sidebar'='\u4f4d\u7f6e\u548c\u8d44\u6e90', 'help'='iph_mspt_location_and_resource' } );
	addpage( [[ 'MSPT IPH System Design' ]], { 'sidebar'='\u7cfb\u7edf\u8bbe\u8ba1', 'help'='iph_mspt_system_design' } );
	addpage( [[ 'Tower SolarPilot Solar Field' ]], { 'sidebar'='\u5b9a\u65e5\u955c\u573a', 'help'='iph_mspt_heliostat_field' } );
	addpage( [[ 'MSPT Receiver External' ], [ 'MSPT Receiver Cavity' ]],
			{ 'sidebar'='\u5854\u548c\u63a5\u6536\u5668', 'help'='iph_mspt_tower_receiver', 'exclusive_var'='receiver_type',
			'exclusive_header_pages' = ['MSPT Receiver']} );
	//addpage( [[ 'MSPT Parallel Heater' ]], { 'sidebar'='\u7535\u52a0\u70edHTF\u52a0\u70ed\u5668', 'help' = 'mspt_electric_htf_heater' } );
	addpage( [[ 'TES Direct Two Tank' ]], { 'sidebar'='\u50a8\u70ed', 'help'='iph_mspt_thermal_storage' } );
	addpage( [[ 'MSPT IPH System Control' ,
	{'name' = 'MSPT IPH Dispatch Control', 'caption'='Dispatch Control', 'collapsible'=false, 'collapsible_var'='csp_dispatch_is_shown'} ]],
	  { 'sidebar'='\u7cfb\u7edf\u63a7\u5236', 'help'='iph_mspt_system_control' } );
}

